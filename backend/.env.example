# ─────────────────────────────────────────────────────────
# Attack Chain Mapper — Backend Environment
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────

# Ollama configuration
# Default: http://127.0.0.1:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Model to use for attack chain reasoning
# Must be pulled: ollama pull qwen2.5-coder:3b
OLLAMA_MODEL=qwen2.5-coder:3b

# Optional: OpenRouter API key for fallback inference
# Only used if Ollama is unavailable and this key is set.
# Leave blank to enforce local-only operation.
OPENROUTER_API_KEY=

# CORS — restrict to the Electron renderer and dev server
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,app://.

# Optional: GitHub token for report deployment (not required for local use)
GITHUB_TOKEN=
